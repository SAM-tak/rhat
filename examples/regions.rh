let^makeNumbers = f^-> i32^[grow^] {
    var^result : i32^[grow^] = {10, 20}
    result.push(30)
    return^result
}

var^numbers : i32^[grow^] = makeNumbers()
let^first = ref^numbers[0]
var^i : i64^= 0
repeat^while^i < 2000 {
    numbers.push(7)
    i := i + 1
}
assert^(*first = 10)
assert^(numbers.len = 2003)
print^(*first, numbers.len)
do^{
    var^scratch : i32^[grow^] = {100, 200}
    print^(scratch[1])
}
