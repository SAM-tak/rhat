def^ Named {
    abstract^ name : f^self^ -> string^;
    greet = p^self^ { print(self^.name()) },
}

def^ Person : Named {
    self^{ private^ text : string^ = "R^ Person" },
    override^ name = f^self^ -> string^ { return^ self^.text },
}

def^ File {
    name = f^self^ -> string^ { return^ "file.rh" },
}

let^ nominal = p^ item:Named { item.greet() }

template^
let^ structural = p^ item { print(item.name()) }

let^ main = p^ {
    var^ person = Person.new()
    let^ file = File.new()
    nominal(person)
    structural(person)
    structural(file)
}
