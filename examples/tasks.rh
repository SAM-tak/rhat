# Heavy work on a std.task Pool while the main thread's Loop keeps ticking.

let^async = import^std.async
let^task = import^std.task

# Counts the primes below n, letting its worker look at its other jobs now and then.
let^primes = p^n:i64^{
    var^count:i64^= 0
    var^k:i64^= 2
    repeat^while^k < n {
        var^prime = true^
        var^d:i64^= 2
        repeat^while^d * d <= k and^prime {
            if^k % d = 0 { prime := false^}
            d += 1
        }
        if^prime { count += 1 }
        k += 1
        if^k % 5000 = 0 { yield^i64^(0) }
    }
    return^count
}

# Waits for a job in a coroutine, so the Loop keeps running the others.
let^report = p^name:string^, t:ref^task.Task<i64^> {
    let^r = try^await^t.join()
    print^(name, r.value)
    return^nil^
}

let^ticker = p^{
    var^k:i64^= 0
    repeat^while^k < 5 {
        await^async.delay(0.05)
        print^("tick", k)
        k += 1
    }
    return^nil^
}

let^main = p^-> nil^| task.Error {
    var^pool = try^task.Pool.new(0) # one worker per hardware thread
    var^small = try^pool.async(primes(100000))
    var^large = try^pool.async(primes(400000))
    var^a = report("primes below 100000:", ref^small)
    var^b = report("primes below 400000:", ref^large)
    var^c = ticker()
    var^loop = async.Loop<nil^| task.Error>{}
    loop.add(ref^a)
    loop.add(ref^b)
    loop.add(ref^c)
    loop.run()
    return^nil^
}

let^result = main()
