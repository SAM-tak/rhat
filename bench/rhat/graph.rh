# Port of aardappel/goose bench/goose/graph.goose, Apache-2.0.
# CSR variant matching C++ VARIANT 1 / Rust CSR, including two-pass build cost.
# Same RNG, edge multiset, BFS sources and checksum; linked version is retained
# in variants/graph_linked.rh.

let^ next = f^ x:u64^ -> u64^ {
    var^ r=x bitxor^ (x bitshift^ 13)
    r := r bitxor^ (r bitshift^ -7)
    return^ r bitxor^ (r bitshift^ 17)
}

let^ enqueue = p^ q:&i32^[>..], tail:&i64^, vertex:i32^ {
    if^ *tail < q.len { q[*tail] := vertex }
    else^ { q.push(vertex) }
    *tail := *tail+1
}

let^ nv:i64^=100000 # BENCH_N
let^ ne=nv*8
var^ esrc:i32^[>..]=[]
var^ edst:i32^[>..]=[]
var^ start:i32^[>..]=[]
var^ fill:i32^[>..]=[]
var^ out:i32^[>..]=[]
var^ dist:i32^[>..]=[]
var^ q:i32^[>..]=[]
var^ r:u64^=12345
var^ i:i64^=0
while^ i < ne {
    r := next(r)
    esrc.push(i32^(r % u64^(nv)))
    edst.push(i32^((r bitshift^ -24) % u64^(nv)))
    i := i+1
}
i := 0
while^ i < nv+1 { start.push(0); i := i+1 }
i := 0
while^ i < ne {
    let^ u=i64^(esrc[i])+1
    start[u] := start[u]+1
    i := i+1
}
i := 0
while^ i < nv { start[i+1] := start[i+1]+start[i]; i := i+1 }
i := 0
while^ i < nv+1 { fill.push(start[i]); i := i+1 }
i := 0
while^ i < ne { out.push(0); i := i+1 }
i := 0
while^ i < ne {
    let^ u=esrc[i]
    let^ at=fill[u]
    out[at] := edst[i]
    fill[u] := at+1
    i := i+1
}
i := 0
while^ i < nv { dist.push(0); i := i+1 }

var^ total:i64^=0
var^ seed:u64^=999
var^ source:i32^=0
while^ source < 4 {
    seed := next(seed)
    let^ src=i32^(seed % u64^(nv))
    i := 0
    while^ i < nv { dist[i] := -1; i := i+1 }
    dist[src] := 0
    var^ tail:i64^=0
    enqueue(&q,&tail,src)
    var^ head:i64^=0
    while^ head < tail {
        let^ u=q[head]
        head := head+1
        let^ d=dist[u]
        total := total+i64^(d)
        var^ k=start[u]
        let^ end=start[u+1]
        while^ k < end {
            let^ w=out[k]
            if^ dist[w] < 0 {
                dist[w] := d+1
                enqueue(&q,&tail,w)
            }
            k := k+1
        }
    }
    assert(tail <= nv)
    source := source+1
}
print(nv+ne)
print(total)
