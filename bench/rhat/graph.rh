import^std.random
# Port of aardappel/goose bench/goose/graph.goose, Apache-2.0.
# CSR variant matching C++ VARIANT 1 / Rust CSR, including two-pass build cost.
# Same RNG, edge multiset, BFS sources and checksum; linked version is retained
# in variants/graph_linked.rh.

let^enqueue = p^q:ref^i32^[grow^], tail:ref^i64^, vertex:i32^{
    if^*tail < q.len { q[*tail] := vertex else^:q.push(vertex) }
    *tail += 1
}

let^nv:i64^= 100000 # BENCH_N
let^ne = nv * 8
var^esrc:i32^[grow^] = {}
var^edst:i32^[grow^] = {}
var^start:i32^[grow^] = {}
var^fill:i32^[grow^] = {}
var^out:i32^[grow^] = {}
var^dist:i32^[grow^] = {}
var^q:i32^[grow^] = {}
var^r:u64^= 12345
var^i:i64^= 0
repeat^while^i < ne {
    r := std.random.xorshift64(r)
    esrc.push(i32^(r % u64^(nv)))
    edst.push(i32^((r bitshift^-24) % u64^(nv)))
    i += 1
}
i := 0
repeat^while^i < nv + 1 { start.push(0); i += 1 }
i := 0
repeat^while^i < ne {
    let^u = i64^(esrc[i]) + 1
    start[u] := start[u] + 1
    i += 1
}
i := 0
repeat^while^i < nv { start[i + 1] += start[i]; i += 1 }
i := 0
repeat^while^i < nv + 1 { fill.push(start[i]); i += 1 }
i := 0
repeat^while^i < ne { out.push(0); i += 1 }
i := 0
repeat^while^i < ne {
    let^u = esrc[i]
    let^at = fill[u]
    out[at] := edst[i]
    fill[u] := at + 1
    i += 1
}
i := 0
repeat^while^i < nv { dist.push(0); i += 1 }

var^total:i64^= 0
var^seed:u64^= 999
var^source:i32^= 0
repeat^while^source < 4 {
    seed := std.random.xorshift64(seed)
    let^src = i32^(seed % u64^(nv))
    i := 0
    repeat^while^i < nv { dist[i] := -1; i += 1 }
    dist[src] := 0
    var^tail:i64^= 0
    enqueue(ref^q, ref^tail, src)
    var^head:i64^= 0
    repeat^while^head < tail {
        let^u = q[head]
        head += 1
        let^d = dist[u]
        total := total + i64^(d)
        var^k = start[u]
        let^end = start[u + 1]
        repeat^while^k < end {
            let^w = out[k]
            if^dist[w] < 0 {
                dist[w] := d + 1
                enqueue(ref^q, ref^tail, w)
            }
            k += 1
        }
    }
    assert^(tail <= nv)
    source += 1
}
print^(nv + ne)
print^total
