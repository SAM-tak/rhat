import^ std.random
# Port of aardappel/goose bench/goose/records_fixed.goose, Apache-2.0.
# Native nominal sum type: fixed-capacity inline text, 24-byte records.
def^ Tick {}
def^ Move { self^{ id:i32^, dx:i16^, dy:i16^ } }
def^ Text { self^{ len:u8^, bytes:u8^[15] } }
def^ Say { self^{ id:i32^, text:Text } }
def^ Quit { self^{ id:i32^, code:u8^ } }
def^ Event = Tick | Move | Say | Quit

let^ word=f^ seed:u64^ -> Text {
    var^ out=Text{}
    var^ r=std.random.xorshift64(seed)
    out.len := u8^(r % 12)+4
    var^ i:u8^=0
    repeat^ while^ i < out.len {
        r := std.random.xorshift64(r)
        out.bytes[i] := u8^(r % 26)+97
        i := i+1
    }
    return^ out
}
let^ score=f^ event:Event -> i64^ {
    if^ event fits^ Tick { return^ 1 }
    if^ event fits^ Move {
        let^ m=event
        return^ i64^(m.id)+i64^(m.dx)+i64^(m.dy)
    }
    if^ event fits^ Say {
        let^ s=event
        return^ i64^(s.id)+i64^(s.text.len)+i64^(s.text.bytes[0])
    }
    let^ q=event
    return^ i64^(q.id)+i64^(q.code)
}
let^ n:i64^=500000 # BENCH_N
var^ log:grow^ Event[]=[]
var^ r:u64^=12345
var^ i:i64^=0
repeat^ while^ i < n {
    r := std.random.xorshift64(r)
    let^ k=r % 8
    let^ id=i32^((r bitshift^ -3) % 100000)
    if^ k < 4 {
        log.push(Move{id=id,dx=i16^((r bitshift^ -20) % 201)-100,dy=i16^((r bitshift^ -40) % 201)-100})
    else^: if^ k < 6 { log.push(Say{id=id,text=word(r)}) else^: if^ k < 7 { log.push(Quit{id=id,code=u8^((r bitshift^ -20) % 256)}) else^: log.push(Tick{}) } } }
    i := i+1
}
var^ total:i64^=0
var^ pass:i32^=0
repeat^ while^ pass < 4 {
    i := 0
    repeat^ while^ i < log.len { total := total+score(log[i]); i := i+1 }
    pass := pass+1
}
print^(log.len)
print^(total)
