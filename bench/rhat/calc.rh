import^ std.random
# Port of aardappel/goose bench/goose/calc.goose, Apache-2.0.
# Nominal AST/result unions; u32 indices; explicit errors; reusable text/node regions.
def^ Num { self^{ value:i64^ } }
def^ Neg { self^{ of:u32^ } }
def^ Paren { self^{ of:u32^ } }
def^ Bin { self^{ op:u8^, l:u32^, r:u32^ } }
def^ Expr = Num | Neg | Paren | Bin
def^ Parsed { self^{ index:u32^ } }
def^ Failure { self^{ code:i32^ } }
def^ ParseResult = Parsed | Failure
def^ Ok { self^{ value:u64^ } }
def^ EvalResult = Ok | Failure
def^ Cursor { self^{ pos:i64^=0 } }
def^ Stats { self^{ chars:i64^=0, nodes:i64^=0, ok:i64^=0, sum:u64^=0, errors:i64^[5] } }

let^ emit_num=p^ text:&u8^[>..], value:u64^ {
    if^ value >= 10 { text.push(u8^(value/10)+48) }
    text.push(u8^(value % 10)+48)
}
let^ gen=p^ text:&u8^[>..], depth:i64^, seed:u64^ -> u64^ {
    var^ r=std.random.xorshift64(seed)
    let^ k=r % 8
    if^ depth = 0 or^ k = 0 { emit_num(text,1+(r bitshift^ -8) % 99); return^ r }
    if^ k = 1 { text.push(45); return^ this^(text,depth-1,r) }
    if^ k = 2 {
        text.push(40)
        r := this^(text,depth-1,r)
        text.push(41)
        return^ r
    }
    r := this^(text,depth-1,r)
    let^ op=(r bitshift^ -16) % 4
    text.push(32)
    if^ op = 0 { text.push(43) }
    else^ { if^ op = 1 { text.push(45) }
        else^ { if^ op = 2 { text.push(42) } else^ { text.push(47) } } }
    text.push(32)
    return^ this^(text,depth-1,std.random.xorshift64(r))
}
let^ corrupt=p^ text:&u8^[>..], seed:u64^ {
    let^ kind=seed % 16
    if^ kind = 0 {
        var^ i=text.len
        while^ i > 0 {
            i := i-1
            if^ text[i] = 41 { text[i] := 32; return^ }
        }
        text[0] := 35
        return^
    }
    if^ kind = 1 { text[(seed bitshift^ -8) % u64^(text.len)] := 35; return^ }
    if^ kind = 2 { text.truncate(text.len/2); return^ }
    if^ kind = 3 { text.append(" / 0") }
}
let^ skip=p^ text:u8^[:], c:&Cursor {
    while^ c.pos < text.len and^ text[c.pos] = 32 { c.pos := c.pos+1 }
}
let^ parse_factor=p^ text:u8^[:], c:&Cursor, pool:&Expr[>..] -> ParseResult {
    skip(text,c)
    if^ c.pos >= text.len { return^ Failure{code=1} }
    let^ ch=text[c.pos]
    if^ ch >= 48 and^ ch <= 57 {
        var^ value:i64^=0
        while^ c.pos < text.len and^ text[c.pos] >= 48 and^ text[c.pos] <= 57 {
            value := value*10+i64^(text[c.pos])-48
            c.pos := c.pos+1
        }
        pool.push(Num{value=value})
        return^ Parsed{index=u32^(pool.len-1)}
    }
    if^ ch = 45 {
        c.pos := c.pos+1
        let^ child=this^(text,c,pool)
        if^ child.is(Failure) { return^ child }
        pool.push(Neg{of=child.get(Parsed).index})
        return^ Parsed{index=u32^(pool.len-1)}
    }
    if^ ch != 40 { return^ Failure{code=3} }
    c.pos := c.pos+1
    let^ inside=parse_expr(text,c,pool)
    if^ inside.is(Failure) { return^ inside }
    skip(text,c)
    if^ c.pos >= text.len or^ text[c.pos] != 41 { return^ Failure{code=2} }
    c.pos := c.pos+1
    pool.push(Paren{of=inside.get(Parsed).index})
    return^ Parsed{index=u32^(pool.len-1)}
}
let^ parse_term=p^ text:u8^[:], c:&Cursor, pool:&Expr[>..] -> ParseResult {
    var^ lhs=parse_factor(text,c,pool)
    if^ lhs.is(Failure) { return^ lhs }
    while^ true^ {
        skip(text,c)
        if^ c.pos >= text.len { return^ lhs }
        let^ op=text[c.pos]
        if^ op != 42 and^ op != 47 { return^ lhs }
        c.pos := c.pos+1
        let^ rhs=parse_factor(text,c,pool)
        if^ rhs.is(Failure) { return^ rhs }
        pool.push(Bin{op=op,l=lhs.get(Parsed).index,r=rhs.get(Parsed).index})
        lhs := Parsed{index=u32^(pool.len-1)}
    }
    return^ lhs
}
let^ parse_expr=p^ text:u8^[:], c:&Cursor, pool:&Expr[>..] -> ParseResult {
    var^ lhs=parse_term(text,c,pool)
    if^ lhs.is(Failure) { return^ lhs }
    while^ true^ {
        skip(text,c)
        if^ c.pos >= text.len { return^ lhs }
        let^ op=text[c.pos]
        if^ op != 43 and^ op != 45 { return^ lhs }
        c.pos := c.pos+1
        let^ rhs=parse_term(text,c,pool)
        if^ rhs.is(Failure) { return^ rhs }
        pool.push(Bin{op=op,l=lhs.get(Parsed).index,r=rhs.get(Parsed).index})
        lhs := Parsed{index=u32^(pool.len-1)}
    }
    return^ lhs
}
let^ eval=f^ pool:&Expr[>..], index:u32^ -> EvalResult {
    let^ node=pool[index]
    if^ node.is(Num) { return^ Ok{value=u64^(node.get(Num).value)} }
    if^ node.is(Neg) {
        let^ result=this^(pool,node.get(Neg).of)
        if^ result.is(Failure) { return^ result }
        return^ Ok{value=0-result.get(Ok).value}
    }
    if^ node.is(Paren) { return^ this^(pool,node.get(Paren).of) }
    let^ bin=node.get(Bin)
    let^ left=this^(pool,bin.l)
    if^ left.is(Failure) { return^ left }
    let^ right=this^(pool,bin.r)
    if^ right.is(Failure) { return^ right }
    let^ a=left.get(Ok).value
    let^ b=right.get(Ok).value
    if^ bin.op = 43 { return^ Ok{value=a+b} }
    if^ bin.op = 45 { return^ Ok{value=a-b} }
    if^ bin.op = 42 { return^ Ok{value=a*b} }
    if^ b = 0 { return^ Failure{code=4} }
    return^ Ok{value=a/b}
}
let^ run=p^ text:u8^[:], pool:&Expr[>..] -> EvalResult {
    var^ c=Cursor{}
    let^ parsed=parse_expr(text,&c,pool)
    if^ parsed.is(Failure) { return^ parsed.get(Failure) }
    skip(text,&c)
    if^ c.pos != text.len { return^ Failure{code=3} }
    return^ eval(pool,parsed.get(Parsed).index)
}
let^ n:i64^=100000 # BENCH_N
var^ text:u8^[>..]=[]
var^ pool:Expr[>..]=[]
var^ seed:u64^=12345
var^ stats=Stats{}
var^ i:i64^=0
while^ i < n {
    seed := std.random.xorshift64(seed)
    text.clear()
    let^ depth=i64^(seed % 4)+3
    let^ s=gen(&text,depth,seed bitshift^ -8)
    corrupt(&text,s)
    stats.chars := stats.chars+text.len
    pool.clear()
    let^ result=run(text.slice(0,text.len),&pool)
    stats.nodes := stats.nodes+pool.len
    if^ result.is(Ok) {
        stats.ok := stats.ok+1
        stats.sum := stats.sum*31+result.get(Ok).value
    } else^ {
        let^ error=result.get(Failure).code
        stats.errors[error] := stats.errors[error]+1
    }
    i := i+1
}
print(stats.chars)
print(stats.nodes)
print(stats.ok)
print(stats.errors[1])
print(stats.errors[2])
print(stats.errors[3])
print(stats.errors[4])
print(stats.sum)
