  "harness_source": "from pathlib import Path\nimport json,sys,shutil,subprocess\nfrom datetime import datetime,timezone\nroot=Path(__file__).resolve().parents[1]\nsys.path.insert(0,str(root/'bench'))\nfrom run_bench import measure,sha,sized\nfrom artifacts import Executables\nbaseline=json.loads((root/'bench/pre_array_fastpaths/workloads_results.json').read_text())\ncompiler=root/'build/Release/rhat.exe'\nclang=shutil.which('clang')\nwork=root/'build/array-paired'; work.mkdir(exist_ok=True)\nout=root/'bench/array_codegen_comparison';out.mkdir(exist_ok=True)\nregistry=Executables()\ndata=dict(started_utc=datetime.now(timezone.utc).isoformat(),policy='alternating order; two warmups; best of three',before_source='bench/pre_array_fastpaths/workloads_results.json',before_environment=baseline['environment'],compiler_sha256=sha(compiler),runtime_sha256=sha(root/'runtime/rhat_runtime.c'),builds=[],rows=[],harness_source=Path(__file__).read_text())\nfor name in ('sum','push','blur'):\n old=next(r for r in baseline['rows'] if r['workload']==name and r['size']=='medium' and r['language']=='rhat')\n before=Path(old['executable'])\n assert sha(before)==old['executable_sha256']\n src=work/f'{name}_medium.rh';exe=work/f'after_{name}.exe'\n sized(root/f'bench/rhat/{name}.rh',src,old['n'])\n oldsrc=before.parent/f'{name}_medium.rh'\n assert sha(src)==sha(oldsrc),(name,'input source mismatch')\n cmd=list(map(str,[compiler,'build',src,'-o',exe,'-O2','--clang',clang]))\n subprocess.run(cmd,check=True);data['builds'].append(cmd)\n registry.add(before);registry.add(exe)\n samples={'before':[],'after':[]};warmups={'before':[],'after':[]}\n expected=old['samples'][0]['output']\n for iteration in range(5):\n  order=[('before',before),('after',exe)]\n  if iteration%2:order.reverse()\n  for label,path in order:\n   result=registry.measure(path,lambda p:measure(p,1800))\n   assert result['output']==expected\n   (warmups if iteration<2 else samples)[label].append(result)\n for label,path in [('before',before),('after',exe)]:\n  data['rows'].append(dict(workload=name,size='medium',n=old['n'],implementation=label,executable=str(path),executable_sha256=registry.hashes[registry.key(path)],source_sha256=sha(src),samples=samples[label],warmups=warmups[label],best_ms=min(s['ms'] for s in samples[label]),peak_bytes=max(s['peak_bytes'] for s in samples[label])))\n a,b=data['rows'][-2:]\n print(name,round(a['best_ms'],2),'->',round(b['best_ms'],2),'ms; speedup',round(a['best_ms']/b['best_ms'],2),flush=True)\n data['executable_hashes']=registry.hashes\n (out/'results.json').write_text(json.dumps(data,indent=2)+'\\n',encoding='utf-8')\nlines=['# Inline array access and leaner push: paired comparison','',f\"Measured: {data['started_utc']} UTC.\",'','Same medium inputs, same toolchain, checked array access, alternating execution order.','Two warmups and best of three whole-process times; executable SHA-256 is checked before and after each run.','The before binaries use static data stacks already. This compares inline array access, leaner push, and inline integer division/remainder guards.','C++/Rust comparisons remain in [the full suite](../results.md).','','| Workload | Parameter | Before ms | After ms | Before / after |','|---|---:|---:|---:|---:|']\nfor name in ('sum','push','blur'):\n a,b=[r for r in data['rows'] if r['workload']==name]\n lines.append(f\"| {name} | {a['n']} | {a['best_ms']:.2f} | {b['best_ms']:.2f} | {a['best_ms']/b['best_ms']:.2f}x |\")\nlines+=['','Raw samples, checksums, executable identities, compiler/runtime hashes and the measuring script are in [results.json](results.json).','']\n(out/'results.md').write_text('\\n'.join(lines),encoding='utf-8')\n",
