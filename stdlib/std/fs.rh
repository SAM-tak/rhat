module^std.fs

# Files, and whole-file reads and writes over them. Paths are UTF-8; the runtime opens them as
# the system needs (UTF-16 on Windows).

let^io = import^std.io
import^std.sys

externC^rh_fs_open:p^path:read^u8^[..], length:i64^, mode:string^-> i64^;
externC^rh_fs_read:p^file:i64^, buffer:u8^[..], capacity:i64^-> i64^;
externC^rh_fs_write:p^file:i64^, data:read^u8^[..], length:i64^-> i64^;
externC^rh_fs_flush:p^file:i64^-> i64^;
externC^rh_fs_close:p^file:i64^-> i64^;
externC^rh_fs_remove:p^path:read^u8^[..], length:i64^-> bool^;

public^errordef^Error { OpenFailed }

# An open file, closed when its scope ends. Close it yourself to learn whether writing it out
# succeeded; using it after that answers io.Error.Closed.
public^def^File : io.Stream, std.sys.Disposable {
    self^{ private^handle:i64^}

    private^opened = p^path:string^, mode:string^-> Self^| Error.OpenFailed {
        let^handle = rh_fs_open(path.bytes, path.bytes.len, mode)
        if^handle = 0 { return^Error.OpenFailed{} }
        return^Self^{handle = handle}
    }
    # Opens a file that exists, for reading.
    for_reading = p^path:string^-> Self^| Error.OpenFailed { return^def^.opened(path, "rb") }
    # Creates the file or replaces its contents.
    for_writing = p^path:string^-> Self^| Error.OpenFailed { return^def^.opened(path, "wb") }
    # Adds to the end of the file, creating it if it is not there.
    for_appending = p^path:string^-> Self^| Error.OpenFailed { return^def^.opened(path, "ab") }

    read = p^self^, out:ref^u8^[grow^], max:i64^-> i64^| io.Error {
        if^self^.handle = 0 { return^io.Error.Closed{} }
        if^max <= 0 { return^0 }
        var^buffer = u8^[]{0 repeat^max}
        let^n = rh_fs_read(self^.handle, buffer[..], max)
        if^n < 0 { return^io.Error.ReadFailed{} }
        out.append(buffer[0 .. n])
        return^n
    }
    write = p^self^, data:read^u8^[..] -> nil^| io.Error {
        if^self^.handle = 0 { return^io.Error.Closed{} }
        return^written(rh_fs_write(self^.handle, data, data.len))
    }
    override^flush = p^self^-> nil^| io.Error {
        if^self^.handle = 0 { return^io.Error.Closed{} }
        return^written(rh_fs_flush(self^.handle))
    }
    close = p^self^-> nil^| io.Error {
        if^self^.handle = 0 { return^io.Error.Closed{} }
        let^handle = self^.handle
        self^.handle := 0
        return^written(rh_fs_close(handle))
    }
    dispose = p^self^{
        if^self^.handle != 0 {
            rh_fs_close(self^.handle)
            self^.handle := 0
        }
    }
}

let^written = f^code:i64^-> nil^| io.Error {
    if^code < 0 { return^io.Error.WriteFailed{} }
    return^nil^
}

# Opens a file that exists, for reading.
public^let^open = p^path:string^-> File | Error.OpenFailed { return^File.for_reading(path) }

# Creates the file or replaces its contents.
public^let^create = p^path:string^-> File | Error.OpenFailed { return^File.for_writing(path) }

# Appends the whole file to out. On failure out may hold part of it.
public^let^read = p^path:string^, out:ref^u8^[grow^] -> nil^| Error.OpenFailed | io.Error {
    var^file = try^open(path)
    try^file.read_all(out)
    return^nil^
}

# The whole file as a new array, which the caller owns.
overload^read = p^path:string^-> u8^[grow^] | Error.OpenFailed | io.Error {
    var^out = u8^[grow^]{}
    try^read(path, ref^out)
    return^out
}

# Creates the file or replaces its contents.
public^let^write = p^path:string^, data:read^u8^[..] -> nil^| Error.OpenFailed | io.Error {
    var^file = try^create(path)
    try^file.write(data)
    return^file.close()
}

# Adds to the end of the file, creating it if it is not there.
public^let^append = p^path:string^, data:read^u8^[..] -> nil^| Error.OpenFailed | io.Error {
    var^file = try^File.for_appending(path)
    try^file.write(data)
    return^file.close()
}

# Whether a file can be opened for reading.
public^let^exists = p^path:string^{
    let^file = rh_fs_open(path.bytes, path.bytes.len, "rb")
    return^file != 0 and^rh_fs_close(file) = 0
}

# Deletes the file; false if there was none or it could not be removed.
public^let^delete = p^path:string^{ return^rh_fs_remove(path.bytes, path.bytes.len) }
