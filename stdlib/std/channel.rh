module^std.channel

let^async = import^std.async
import^std.sys

public^errordef^Error { InvalidCapacity, OutOfMemory, Closed, Full, MessageTooLarge }
public^def^Closed {}
public^def^Empty {}
public^struct^Message<T> { value:T }

let^sent = f^status:i64^-> nil^| Error {
    for^status:
    when^1: Error.Closed{}
    when^2: Error.Full{}
    when^3: Error.MessageTooLarge{}
    when^4: Error.OutOfMemory{}
    other^: nil^;
}

# A bounded queue with explicit shared holds. The element type must own its data.
public^def^Channel<T> {
    self^{ private^handle:channel_handle^<T> = {} }  # a default channel is closed

    new = p^messages:i64^, bytes:i64^-> Self^| Error {
        if^messages <= 0 or^bytes <= 0 { return^Error.InvalidCapacity{} }
        var^result = Self^{handle = channel_new^(T, messages, bytes)}
        if^!channel_valid^(ref^result.handle) { return^Error.OutOfMemory{} }
        return^result
    }
    clone = p^self^-> Self^{
        return^Self^{handle = channel_clone^(ref^self^.handle)}
    }
    send = p^self^, value:ref^read^T -> nil^| Error {
        return^sent(channel_send^(ref^self^.handle, value, i64^(1)))
    }
    try_send = p^self^, value:ref^read^T -> nil^| Error {
        return^sent(channel_send^(ref^self^.handle, value, i64^(0)))
    }
    receive = p^self^-> Message<T> | Closed | Empty {
        return^channel_receive^(ref^self^.handle, i64^(1))
    }
    try_receive = p^self^-> Message<T> | Closed | Empty {
        return^channel_receive^(ref^self^.handle, i64^(0))
    }
    close = p^self^{
        channel_close^(ref^self^.handle)
    }
    # Whether a message is there or the channel is closed: receive will not wait.
    ready = p^self^-> bool^{ return^channel_ready^(ref^self^.handle) }
    # A std.async wait that is ready once a message arrives or the channel closes; yield it,
    # then try_receive.
    awaitable = p^self^-> i64^{
        let^wait = async.external()
        channel_watch^(ref^self^.handle, wait.token)
        return^wait.id
    }
    # Waits for a message in a coroutine: let^m = await^ ch.take(). It answers Empty only when
    # another receiver took the message first.
    take = p^self^{
        repeat^{
            if^!self^.ready() {
                yield^self^.awaitable()
                next^
            }
            return^self^.try_receive()
        }
    }
}
