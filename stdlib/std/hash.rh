module^std.hash

# Spreads every input bit over the result (the MurmurHash3 finalizer).
public^let^mix = f^x:u64^ -> u64^ {
    var^h = x
    h := (h bitxor^ (h bitshift^ -33)) * 0xFF51AFD7ED558CCD
    h := (h bitxor^ (h bitshift^ -33)) * 0xC4CEB9FE1A85EC53
    return^h bitxor^ (h bitshift^ -33)
}

# FNV-1a over the bytes, then mixed.
public^let^bytes = f^data:u8^[..] -> u64^ {
    var^h:u64^ = 0xCBF29CE484222325
    for^i in^0 .. data.len {
        h := (h bitxor^ u64^(data[i])) * 0x100000001B3
    }
    return^mix(h)
}

# Folds the hash of one more field into seed. Hash a def^ key with this:
# hash = f^self^ -> u64^ { combine(of(self^.a), of(self^.b)) }
public^let^combine = f^seed:u64^, h:u64^ -> u64^ {
    return^mix(seed * 31 + h)
}

# The hash of a string^, an integer, a char^, a bool^, or a value with a hash method.
# Floats have none: NaN differs from itself and -0.0 equals 0.0.
public^let^of = template^f^x -> u64^ {
    for^x:
    when^fits^string^: bytes(x.bytes)
    when^fits^bool^: if^x: mix(1) el^: mix(0);
    when^fits^char^: mix(u64^(u32^(x)))
    when^fits^u8^: mix(u64^(x))
    when^fits^u16^: mix(u64^(x))
    when^fits^u32^: mix(u64^(x))
    when^fits^u64^: mix(x)
    when^fits^i8^: mix(u64^(i64^(x)))
    when^fits^i16^: mix(u64^(i64^(x)))
    when^fits^i32^: mix(u64^(i64^(x)))
    when^fits^i64^: mix(u64^(x))
    other^: x.hash();
}
