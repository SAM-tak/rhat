module^std.sys

public^errordef^Error { OutOfMemory, CastFail }

# Opaque C ABI types used by the thread bridge operations.
public^externC^def^ThreadArgs;
public^externC^def^ThreadTransfer;
public^def^ThreadEntry = externC^p^ref^ThreadArgs;

# A scope calls dispose when it ends. Such values cannot be copied, and dispose cannot be
# called directly. It cannot fail; use an explicit close method for operations that can fail.
public^def^Disposable {
    abstract^dispose:p^self^;
}

# What a coroutine frame offers: start runs it to its first yield^, resume to the next one
# (handing in an R when it receives one), and each answers what was yielded (Y) or, at the end,
# returned (T). A coroutine that receives nothing has R nil^ and resumes with no argument.
public^def^Coroutine<R, Y, T> {
    abstract^start:p^self^ -> Y | T;
    abstract^resume:p^self^ -> Y | T;
    abstract^overload^resume:p^self^, value:R -> Y | T;
    abstract^done:f^self^ -> bool^;
    abstract^result:f^self^ -> T;
}
