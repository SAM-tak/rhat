module^std.sys

public^errordef^Error { OutOfMemory, CastFail }

# Opaque C ABI types used by the thread bridge operations.
public^externC^def^ThreadArgs;
public^externC^def^ThreadTransfer;
public^def^ThreadEntry = externC^p^ref^ThreadArgs;

# A scope calls dispose when it ends. Such values cannot be copied, and dispose cannot be
# called directly. It cannot fail; use an explicit close method for operations that can fail.
public^def^Disposable {
    abstract^dispose:p^self^;
}

# What every coroutine frame offers: whether it has finished, and what it finally returned (T).
public^def^Coroutine<T> {
    abstract^done:f^self^ -> bool^;
    abstract^result:f^self^ -> T;
}

# A coroutine that receives nothing: start runs it to its first yield^, resume to the next one,
# and each answers what was yielded (Y) or, at the end, returned (T).
public^def^CoroutineNR<Y, T> : Coroutine<T> {
    abstract^start:p^self^ -> Y | T;
    abstract^resume:p^self^ -> Y | T;
}

# The same, of an f^ body: advancing it writes only the frame.
public^def^PureCoroutineNR<Y, T> : CoroutineNR<Y, T> {
    abstract^start:f^mutable^self^ -> Y | T;
    abstract^resume:f^mutable^self^ -> Y | T;
}

# A coroutine that receives an R at each yield^: resume hands one in.
public^def^CoroutineR<R, Y, T> : Coroutine<T> {
    abstract^start:p^self^ -> Y | T;
    abstract^resume:p^self^, value:R -> Y | T;
}

# The same, of an f^ body.
public^def^PureCoroutineR<R, Y, T> : CoroutineR<R, Y, T> {
    abstract^start:f^mutable^self^ -> Y | T;
    abstract^resume:f^mutable^self^, value:R -> Y | T;
}
