module^std.math.vector2

let^math = import^std.math

# A two-component vector in x-right/y-down coordinates: UP is -y, and a
# positive rotation turns +x toward +y (clockwise on screen). T is a float.
public^def^Vec2<T> {
    self^{ x:T, y:T }

    ZERO = Self^{ x = T.ZERO, y = T.ZERO }
    ONE = Self^{ x = T.ONE, y = T.ONE }
    RIGHT = Self^{ x = T.ONE, y = T.ZERO }
    LEFT = Self^{ x = -T.ONE, y = T.ZERO }
    UP = Self^{ x = T.ZERO, y = -T.ONE }
    DOWN = Self^{ x = T.ZERO, y = T.ONE }

    op^+ = f^self^, other:Self^{ Self^{ x = self^.x + other.x, y = self^.y + other.y } }
    op^- = f^self^, other:Self^{ Self^{ x = self^.x - other.x, y = self^.y - other.y } }
    overload^op^- = f^self^{ Self^{ x = -self^.x, y = -self^.y } }
    op^* = f^self^, scale:T { Self^{ x = self^.x * scale, y = self^.y * scale } }
    overload^op^* = f^scale:T, self^{ Self^{ x = scale * self^.x, y = scale * self^.y } }
    overload^op^* = f^self^, other:Self^{
        Self^{ x = self^.x * other.x, y = self^.y * other.y }
    }
    op^/ = f^self^, scale:T { Self^{ x = self^.x / scale, y = self^.y / scale } }
    overload^op^/ = f^self^, other:Self^{
        Self^{ x = self^.x / other.x, y = self^.y / other.y }
    }
    op^dot^= f^self^, other:Self^-> T { self^.x * other.x + self^.y * other.y }
    # The z component of the 3D cross product: the signed parallelogram area.
    op^cross^= f^self^, other:Self^-> T { self^.x * other.y - self^.y * other.x }

    length = f^self^-> T{ math.sqrt(*self^dot^*self^) }
    # The zero vector stays zero.
    normalized = f^self^-> Self^{
        let^n = self^.length()
        if^n = T.ZERO {
            return^*self^
        }
        return^Self^{ x = self^.x / n, y = self^.y / n }
    }
    # Unclamped: t outside 0..1 extrapolates.
    lerp = f^self^, other:Self^, t:T { *self^+ (other - *self^) * t }
    rotate = f^self^, radians:T {
        let^c = math.cos(radians)
        let^s = math.sin(radians)
        return^Self^{ x = self^.x * c - self^.y * s, y = self^.x * s + self^.y * c }
    }
    # atan2(y, x) in -pi..pi; the zero vector answers 0.
    angle = f^self^-> T {
        if^self^.x = T.ZERO and^self^.y = T.ZERO {
            return^T.ZERO
        }
        return^math.atan2(self^.y, self^.x)
    }
    abs = f^self^{ Self^{ x = math.abs(self^.x), y = math.abs(self^.y) } }
    clamp = f^self^, low:T, high:T {
        Self^{ x = def^.limit(self^.x, low, high), y = def^.limit(self^.y, low, high) }
    }
    overload^clamp = f^self^, low:Self^, high:Self^-> Self^{
        { x = def^.limit(self^.x, low.x, high.x), y = def^.limit(self^.y, low.y, high.y) }
    }
    distance = f^a:Self^, b:Self^-> T { (a - b).length() }

    private^limit = f^value:T, low:T, high:T -> T{
        if^value < low {
            return^low
        }
        if^value > high {
            return^high
        }
        return^value
    }
}

public^let^Vector2 = Vec2<f32^>
